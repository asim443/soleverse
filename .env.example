# ==============================================================================
# SOLEVERSE — Environment Configuration
# ==============================================================================
# Copy this file to `.env` for local development and set these in Vercel
# Project Settings -> Environment Variables for production deployments.
#
# Where to find your Supabase credentials:
# 1. Open your project in https://supabase.com/dashboard
# 2. Go to Project Settings -> API (or Data API / API Keys)
# 3. Copy the "Project URL" into VITE_SUPABASE_URL
# 4. Copy the "anon" / "publishable" public key into VITE_SUPABASE_PUBLISHABLE_KEY
#
# IMPORTANT: NEVER expose the `service_role` or `secret` key in frontend code!
# ==============================================================================

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional runtime variables injected by AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
